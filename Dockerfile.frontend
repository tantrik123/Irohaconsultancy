# Stage 1: Build the React/Vite frontend
FROM node:18.20.3-alpine3.20 AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=https://mail.irohaeduconsultancy.com
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Serve with nginx on port 6000
FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx-iroha.conf /etc/nginx/conf.d/default.conf

EXPOSE 6000

CMD ["nginx", "-g", "daemon off;"]
